{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(pnpm run check)",
      "Bash(pnpm run check:*)",
      "Bash(pnpm run build)",
      "Bash(pnpm install)",
      "Bash(pnpm test:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(node --version)",
      "Bash(npx tsc --noEmit)"
    ]
  }
}
